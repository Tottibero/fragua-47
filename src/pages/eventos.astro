---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Eventos" description="Próximos eventos de Fragua47. Consulta la agenda de quedadas y actividades de la comunidad.">
	<div class="pagina">

		<!-- Columna izquierda: próximos eventos -->
		<div class="proximos-wrap panel-forja">
			<div class="proximos-header">
				<img src="/VectLogoF47.webp" alt="Logo Fragua47" class="proximos-logo" width="300" height="343" />
				<h2 class="proximos-titulo">Próximos Eventos</h2>
				<div class="proximos-sep"></div>
			</div>
			<ul class="proximos-lista" id="proximos-lista"></ul>
		</div>

		<!-- Evento: foto + ficha -->
		<div class="evento-stack frame-forja">
			<div class="evento-foto">
				<img src="/vuelta-al-cole.webp" alt="Vuelta al Cole" loading="lazy" class="evento-img-unica" />
				<div class="evento-brand">
					<img src="/VectLogoF47.webp" alt="Logo Fragua47" class="evento-logo" width="300" height="343" />
					<span class="logo-metalico">FRAGUA47</span>
				</div>
			</div>
			<div class="evento-content superficie-forja">
				<div class="evento-info">
					<h3>VUELTA AL <span class="accent">COLE</span></h3>
					<div class="evento-fecha">
						<span class="fecha-dia">5</span>
						<span class="fecha-div"></span>
						<div class="fecha-detalle">
							<span class="fecha-mes">Septiembre</span>
							<span class="fecha-sub">Sábado · Nº 8</span>
						</div>
					</div>
					<div class="datos-evento">
						<div class="dato-fila">
							<svg class="dato-icon" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M15 8.5a4 4 0 1 0 0 7"/><line x1="6.5" y1="10.5" x2="13" y2="10.5"/><line x1="6.5" y1="13.5" x2="13" y2="13.5"/></svg>
							<span class="dato-valor">25€ entrada</span>
						</div>
						<div class="dato-fila">
							<svg class="dato-icon" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16v4a4 4 0 0 1-4 4h-1a3 3 0 0 0-6 0H8a4 4 0 0 1-4-4V4z"/><path d="M6 20h12"/><path d="M12 12v8"/></svg>
							<span class="dato-valor">Uniforme, fetish o mínimo negro</span>
						</div>
						<div class="dato-fila">
							<svg class="dato-icon" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg>
							<span class="dato-valor">Picoteo incluido · Bebidas en barra</span>
						</div>
						<div class="dato-fila">
							<svg class="dato-icon" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
							<span class="dato-valor">Se indicará al confirmar asistencia</span>
						</div>
					</div>
				</div>
				<div class="footer-card">
					<a href="/eventos/vuelta-al-cole/" class="btn-forja btn-forja--outline btn-forja--sm">Más información</a>
					<button class="btn-inscribete btn-forja btn-forja--sm" id="btn-inscribete">Inscríbete ⚒</button>
				</div>
			</div>
		</div>

			<!-- Calendario navegable -->
			<div class="calendario panel-forja">
				<div class="cal-header">
					<button class="cal-nav" id="cal-prev">‹</button>
					<div class="cal-mes-wrap">
						<img src="/VectLogoF47.webp" alt="Logo Fragua47" class="cal-logo" width="300" height="343" />
						<p class="cal-pre">— agenda —</p>
						<h4 class="cal-titulo" id="cal-titulo"></h4>
					</div>
					<button class="cal-nav" id="cal-next">›</button>
				</div>
				<hr class="linea" />
				<div class="cal-grid" id="cal-grid"></div>
				<hr class="linea" />
				<ul class="agenda" id="agenda-list"></ul>
			</div>

	</div>

	<!-- Modal inscripción -->
	<div class="modal-overlay" id="modal-overlay">
		<div class="modal-documento panel-forja panel-forja--doc">
			<button class="modal-cerrar" id="modal-cerrar" aria-label="Cerrar">✕</button>
			<div class="doc-header">
				<img src="/VectLogoF47.webp" alt="Logo Fragua47" class="modal-logo" width="300" height="343" />
				<h5>Inscripción</h5>
				<span class="doc-sello">⚒</span>
			</div>
			<p class="doc-sub">— VUELTA AL COLE · Fragua47 —</p>
			<hr class="doc-linea" />
			<form id="form-inscripcion">
				<div class="fila-campos">
					<div class="campo">
						<label for="correo-evento">Correo <span class="req">*</span></label>
						<input type="email" id="correo-evento" name="correo" required placeholder="tu@correo.com" />
					</div>
					<div class="campo">
						<label for="alias-evento">Alias <span class="req">*</span></label>
						<input type="text" id="alias-evento" name="alias" required placeholder="¿Cómo te conocemos?" />
					</div>
				</div>
				<div class="campo">
					<label for="fetlife-evento">FetLife <span class="opcional">(opcional)</span></label>
					<input type="text" id="fetlife-evento" name="fetlife" placeholder="Tu nick en FetLife" />
				</div>
				<hr class="doc-linea" />
				<div class="doc-footer">
					<p class="form-msg" id="inscripcion-msg"></p>
					<button type="submit" id="inscripcion-btn" class="btn-enviar btn-forja">Enviar inscripción ⚒</button>
				</div>
			</form>
		</div>
	</div>

</Layout>

<script is:inline>
	// ── Modal ──
	const btn     = document.getElementById('btn-inscribete');
	const overlay = document.getElementById('modal-overlay');
	const cerrar  = document.getElementById('modal-cerrar');
	btn?.addEventListener('click', () => overlay.classList.add('abierto'));
	cerrar?.addEventListener('click', () => overlay.classList.remove('abierto'));
	overlay?.addEventListener('click', (e) => { if (e.target === overlay) overlay.classList.remove('abierto'); });
	document.addEventListener('keydown', (e) => {
		if (e.key === 'Escape') overlay?.classList.remove('abierto');
	});

	document.getElementById('form-inscripcion')?.addEventListener('submit', async (e) => {
		e.preventDefault();
		const form = e.target;
		const ibtn = document.getElementById('inscripcion-btn');
		const msg  = document.getElementById('inscripcion-msg');
		ibtn.disabled = true; ibtn.textContent = 'Enviando...';
		msg.className = 'form-msg'; msg.textContent = '';
		const correo  = document.getElementById('correo-evento').value.trim();
		const alias   = document.getElementById('alias-evento').value.trim();
		const fetlife = document.getElementById('fetlife-evento').value.trim();
		const res = await fetch('/api/inscripcion', { method: 'POST', headers: {'Content-Type':'application/json'}, body: JSON.stringify({ correo, alias, fetlife }) });
		if (res.ok) {
			msg.className = 'form-msg ok';
			msg.textContent = '¡Inscripción enviada! Te confirmamos pronto.';
			form.reset();
		} else {
			msg.className = 'form-msg error';
			msg.textContent = 'Error al enviar. Inténtalo de nuevo.';
		}
		ibtn.disabled = false; ibtn.textContent = 'Enviar inscripción ⚒';
	});

	// ── Próximos eventos (panel izquierdo) ──
	const MESES_FULL = ['Enero','Febrero','Marzo','Abril','Mayo','Junio','Julio','Agosto','Septiembre','Octubre','Noviembre','Diciembre'];

	// ── Calendario ──
	const EVENTOS = [
		{ year: 2026, month: 8,  day:  5, nombre: 'Vuelta al Cole' },
		{ year: 2026, month: 8,  day: 26, nombre: '??' },
		{ year: 2026, month: 9,  day: 24, nombre: '??' },
		{ year: 2026, month: 10, day: 14, nombre: '??' },
		{ year: 2026, month: 11, day: 19, nombre: '??' },
		{ year: 2026, month: 11, day: 31, nombre: '??' },
	];

	const MESES = MESES_FULL;
	const DIAS  = ['L','M','X','J','V','S','D'];

	const now = new Date();
	let curYear  = now.getFullYear();
	let curMonth = now.getMonth(); // 0-indexed

	function render() {
		const titulo = document.getElementById('cal-titulo');
		const grid   = document.getElementById('cal-grid');
		const agenda = document.getElementById('agenda-list');
		titulo.textContent = `${MESES[curMonth]} ${curYear}`;

		// Grid
		const firstDay = new Date(curYear, curMonth, 1).getDay(); // 0=Sun
		const offset   = firstDay === 0 ? 6 : firstDay - 1; // Mon-first
		const daysInMonth = new Date(curYear, curMonth + 1, 0).getDate();
		const today = new Date();

		let html = DIAS.map(d => `<span class="cal-dia-nombre">${d}</span>`).join('');
		for (let i = 0; i < offset; i++) html += `<span class="vacio"></span>`;
		for (let d = 1; d <= daysInMonth; d++) {
			const ev      = EVENTOS.find(e => e.year === curYear && e.month === curMonth && e.day === d);
			const isToday = curYear === today.getFullYear() && curMonth === today.getMonth() && d === today.getDate();
			const isPast  = new Date(curYear, curMonth, d) < new Date(today.getFullYear(), today.getMonth(), today.getDate());
			let cls = '';
			if (isToday && ev) cls = 'evento-dia hoy-dia';
			else if (isToday)  cls = 'hoy-dia';
			else if (ev && isPast) cls = 'evento-dia pasado-dia';
			else if (ev)       cls = 'evento-dia';
			html += `<span class="${cls}">${d}</span>`;
		}
		grid.innerHTML = html;

		// Agenda: solo eventos de este mes
		const mesEventos = EVENTOS.filter(e => e.year === curYear && e.month === curMonth);
		if (mesEventos.length === 0) {
			agenda.innerHTML = `<li class="sin-eventos"><span class="agenda-nombre">Sin eventos este mes</span></li>`;
		} else {
			agenda.innerHTML = mesEventos.map(e => {
				const isPast = new Date(curYear, curMonth, e.day) < new Date(today.getFullYear(), today.getMonth(), today.getDate());
				return `<li class="${isPast ? 'pasado' : ''}">
					<span class="agenda-fecha">${String(e.day).padStart(2,'0')} ${MESES[curMonth].slice(0,3)}</span>
					<span class="agenda-nombre">${e.nombre}</span>
				</li>`;
			}).join('');
		}
	}

	document.getElementById('cal-prev')?.addEventListener('click', () => {
		curMonth--; if (curMonth < 0) { curMonth = 11; curYear--; } render();
	});
	document.getElementById('cal-next')?.addEventListener('click', () => {
		curMonth++; if (curMonth > 11) { curMonth = 0; curYear++; } render();
	});

	render();

	// ── Render panel próximos eventos ──
	(function renderProximos() {
		const lista = document.getElementById('proximos-lista');
		if (!lista) return;
		const today = new Date();
		const todayMidnight = new Date(today.getFullYear(), today.getMonth(), today.getDate());
		const futuroIdx = EVENTOS.findIndex(e => new Date(e.year, e.month, e.day) >= todayMidnight);
		lista.innerHTML = EVENTOS.map((e, i) => {
			const isPast = new Date(e.year, e.month, e.day) < todayMidnight;
			const isNext = i === futuroIdx;
			return `<li class="prox-item${isPast ? ' prox-pasado' : ''}${isNext ? ' prox-next' : ''}">
				<div class="prox-sello">
					<span class="prox-dia">${e.day}</span>
					<span class="prox-mes">${MESES_FULL[e.month]}</span>
				</div>
				<div class="prox-pivot">⚒</div>
				<div class="prox-info">
					<span class="prox-nombre">${e.nombre}</span>
					${isPast ? '<span class="prox-check">✓</span>' : ''}
					${isNext ? '<span class="prox-badge">próxima</span>' : ''}
				</div>
			</li>`;
		}).join('');
	})();
</script>

<style>
	.pagina {
		display: grid;
		grid-template-columns: 1fr 1.4fr;
		grid-template-rows: minmax(0, 1fr) auto;
		grid-template-areas:
			"foto stack"
			"foto cal";
		gap: 1rem;
		margin: 0.6rem auto 0.8rem;
		height: calc(100vh - 148px);
		align-items: stretch;
		overflow: hidden;
	}

	/* ── Panel Próximos Eventos (estructura, no dinámica) ── */

	.proximos-wrap {
		grid-area: foto;
		display: flex;
		flex-direction: column;
		overflow: hidden;
		padding: 0.9rem 0.8rem 0.8rem;
		font-family: 'Cinzel', serif;
	}

	.proximos-header {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.3rem;
		margin-bottom: 0.6rem;
		flex-shrink: 0;
		position: relative;
		z-index: 1;
	}

	.proximos-logo { height: 30px; width: auto; opacity: 0.9; }

	.proximos-titulo {
		font-family: 'Metamorphous', cursive;
		font-size: 0.95rem;
		letter-spacing: 4px;
		text-transform: uppercase;
		color: #2a1208;
		margin: 0;
		text-align: center;
	}

	.proximos-sep {
		width: 55%;
		height: 1px;
		background: linear-gradient(to right, transparent, rgba(42,18,8,0.5), transparent);
	}

	.proximos-lista {
		list-style: none;
		padding: 0;
		margin: 0;
		display: flex;
		flex-direction: column;
		flex: 1;
		justify-content: space-evenly;
		position: relative;
		z-index: 1;
	}

	/* Hilo conductor: enhebra los eventos de arriba a abajo por la
	   columna del pivote (⚒), a modo de línea de tiempo. */
	.proximos-lista::before {
		content: '';
		position: absolute;
		top: 2px;
		bottom: 2px;
		left: 4.6rem;
		width: 1px;
		background: repeating-linear-gradient(
			to bottom,
			rgba(42,18,8,0.35) 0px,
			rgba(42,18,8,0.35) 5px,
			transparent 5px,
			transparent 10px
		);
		z-index: 0;
	}

	/* ── Evento: foto + ficha ── */

	.evento-stack {
		grid-area: stack;
		display: flex;
		flex-direction: column;
		overflow: hidden;
	}

	.evento-foto {
		position: relative;
		flex: 1 1 auto;
		min-height: 0;
		overflow: hidden;
		border-bottom: 3px solid #2a1208;
	}

	.evento-img-unica {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: 50% 35%;
		display: block;
	}

	.evento-brand {
		position: absolute;
		top: 0.5rem;
		right: 0.6rem;
		display: flex;
		align-items: center;
		gap: 0.4rem;
	}

	.evento-logo { height: 18px; width: auto; opacity: 0.95; flex-shrink: 0; filter: drop-shadow(0 1px 3px rgba(0,0,0,0.5)); }

	.logo-metalico {
		font-family: 'Metamorphous', cursive;
		font-size: 0.7rem;
		letter-spacing: 2px;
		color: #fff4e2;
		text-shadow: 0 1px 3px rgba(0,0,0,0.6);
	}

	.evento-content {
		flex-shrink: 0;
		display: flex;
		flex-direction: row;
		align-items: flex-end;
		gap: 0.5rem;
		padding: 0.6rem 0.8rem;
	}

	.evento-info {
		flex: 1;
		display: flex;
		flex-direction: column;
		gap: 0.3rem;
		font-family: 'Cinzel', serif;
	}

	h3 {
		font-family: 'Metamorphous', cursive;
		font-size: 1rem;
		letter-spacing: 2px;
		text-transform: uppercase;
		color: #2a1208;
		margin: 0;
		line-height: 1.1;
	}

	h3 .accent { color: #b44814; }

	.evento-fecha {
		display: flex;
		align-items: center;
		gap: 0.5rem;
	}

	.fecha-dia {
		font-family: 'Metamorphous', cursive;
		font-size: 1.6rem;
		color: #2a1208;
		line-height: 1;
	}

	.fecha-div {
		width: 1px;
		height: 1.4rem;
		background: rgba(42,18,8,0.25);
		flex-shrink: 0;
	}

	.fecha-detalle {
		display: flex;
		flex-direction: column;
		gap: 0.1rem;
	}

	.fecha-mes {
		font-family: 'Cinzel', serif;
		font-size: 0.65rem;
		font-weight: 600;
		letter-spacing: 3px;
		text-transform: uppercase;
		color: #6a2808;
	}

	.fecha-sub {
		font-family: 'Cinzel', serif;
		font-size: 0.55rem;
		letter-spacing: 2px;
		text-transform: uppercase;
		color: #5a3018;
	}

	.datos-evento {
		display: flex;
		flex-direction: column;
		gap: 0;
	}

	.dato-fila {
		display: flex;
		align-items: center;
		gap: 0.35rem;
		padding: 0.18rem 0;
	}

	.dato-icon {
		width: 0.65rem;
		height: 0.65rem;
		min-width: 0.65rem;
		stroke: #b44814;
		flex-shrink: 0;
	}

	.dato-valor {
		font-family: system-ui, -apple-system, sans-serif;
		font-size: 0.6rem;
		color: #2a1208;
		line-height: 1.3;
	}

	.footer-card { display: flex; align-items: flex-end; flex-shrink: 0; gap: 0.5rem; flex-wrap: wrap; }

	.linea {
		border: none;
		border-top: 1.5px solid #2a1208;
		margin: 0.35rem 0;
	}

	/* ── Calendario ── */

	.calendario {
		grid-area: cal;
		padding: 0.5rem 0.8rem;
		font-family: 'Cinzel', serif;
		flex-shrink: 0;
	}

	.cal-header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.5rem;
		margin-bottom: 0.1rem;
	}

	.cal-nav {
		background: #2a1208;
		border: none;
		color: #f5e6d0;
		font-size: 1.1rem;
		width: 28px;
		height: 28px;
		display: flex;
		align-items: center;
		justify-content: center;
		cursor: pointer;
		flex-shrink: 0;
		padding: 0;
		line-height: 1;
		transition: background 0.15s;
	}

	.cal-nav:hover { background: #b44814; }

	.cal-logo {
		height: 18px;
		width: auto;
		opacity: 0.85;
		flex-shrink: 0;
	}

	.cal-mes-wrap {
		display: flex;
		align-items: center;
		gap: 0.4rem;
	}

	.cal-pre {
		font-size: 0.42rem;
		letter-spacing: 2px;
		text-transform: uppercase;
		color: #5a3018;
		margin: 0;
	}

	h4.cal-titulo {
		font-family: 'Metamorphous', cursive;
		font-size: 0.85rem;
		letter-spacing: 2px;
		text-transform: uppercase;
		color: #2a1208;
		margin: 0;
		line-height: 1;
	}

	.cal-grid {
		display: grid;
		grid-template-columns: repeat(7, 1fr);
		gap: 0.1rem;
		margin: 0.25rem 0;
	}

	.cal-dia-nombre {
		font-family: 'Cinzel', serif;
		font-size: 0.45rem;
		letter-spacing: 1px;
		text-transform: uppercase;
		color: #b44814;
		font-weight: 700;
		text-align: center;
		padding-bottom: 0.12rem;
		border-bottom: 1px solid rgba(42,18,8,0.2);
	}

	.cal-grid span:not(.cal-dia-nombre):not(.vacio) {
		font-family: system-ui, -apple-system, sans-serif;
		font-size: 0.65rem;
		color: #2a1208;
		text-align: center;
		padding: 0.15rem 0;
		line-height: 1;
	}

	.vacio { visibility: hidden; }

	.agenda { list-style: none; padding: 0; margin: 0.1rem 0 0; }

	/* ── Agenda ── */

	.agenda {
		list-style: none;
		padding: 0;
		margin: 0.1rem 0 0;
		display: flex;
		flex-direction: column;
	}

	.agenda li {
		display: flex;
		align-items: baseline;
		gap: 0.5rem;
		padding: 0.18rem 0;
		border-bottom: 1px solid rgba(42,18,8,0.12);
	}

	.agenda li:last-child { border-bottom: none; }

	.agenda-fecha {
		font-family: 'Cinzel', serif;
		font-size: 0.48rem;
		letter-spacing: 1.5px;
		text-transform: uppercase;
		color: #b44814;
		font-weight: 700;
		min-width: 2.8rem;
		flex-shrink: 0;
	}

	.agenda-nombre {
		font-family: system-ui, -apple-system, sans-serif;
		font-size: 0.63rem;
		color: #2a1208;
	}

	.agenda li.pasado .agenda-fecha,
	.agenda li.pasado .agenda-nombre {
		color: #9a7a60;
		text-decoration: line-through;
		text-decoration-color: rgba(154,122,96,0.5);
	}

